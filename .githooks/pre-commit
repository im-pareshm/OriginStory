#!/bin/sh
# Blocks commits made directly on main: all work goes through a branch and a pull request.
# Installed by `npm install` (scripts/install-hooks.mjs sets core.hooksPath=.githooks).

branch="$(git symbolic-ref --short HEAD 2>/dev/null)"
if [ "$branch" = "main" ]; then
  echo "pre-commit: direct commits to main are not allowed." >&2
  echo "Create a branch first, e.g.  git switch -c feature/<short-name>" >&2
  exit 1
fi
