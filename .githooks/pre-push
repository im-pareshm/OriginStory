#!/bin/sh
# Blocks pushing to main: main only changes by merging a pull request on the host.
# Installed by `npm install` (scripts/install-hooks.mjs sets core.hooksPath=.githooks).

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: pushing to main is not allowed. Push your branch and open a pull request." >&2
    exit 1
  fi
done
exit 0
